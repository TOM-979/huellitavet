PORT=3000
# Orígenes permitidos (separados por coma). Vacío = cualquiera
CORS_ORIGIN=http://localhost:5173
# Connection string de PostgreSQL (Supabase: Project Settings > Database > Connection string > URI).
# Si se deja vacío, se usa PostgreSQL embebido (PGlite) guardado en backend/data/pglite
DATABASE_URL=
# Carpeta de la base embebida (opcional). ":memory:" = no guarda nada al cerrar
# DB_PATH=./data/pglite
